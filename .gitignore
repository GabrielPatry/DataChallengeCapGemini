# site_analysis: code, final reports and their figures are versioned;
# payloads, prompts and raw LLM answers are regenerated by the scripts
site_analysis/payloads/
site_analysis/prompts/
site_analysis/reports/*.llm.json
site_analysis/figures/*
!site_analysis/figures/OUEST1-*

# Equipment reports (uv run dc-equipment): report.md, its figures and the
# site criticality table are versioned; json/ and sections/ (section
# markdowns, prompts, cached Azure answers) are regenerated by the pipeline
equipment_reports/*/*/*
!equipment_reports/*/*/report.md
!equipment_reports/*/*/figures/
